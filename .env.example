# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=

# ElevenLabs (speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Databricks (storage + dashboard)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_HTTP_PATH=
DATABRICKS_CATALOG=spanner

# fal (generated media + detector fallback)
FAL_KEY=

# Adaption fine-tunes, served on Together AI or any OpenAI-style chat endpoint
TOGETHER_API_KEY=
ADAPTION_API_KEY=            # only for a non-Together endpoint; takes precedence over TOGETHER_API_KEY
ADAPTION_BASE_URL=https://api.together.xyz/v1
# The step tracker's fine-tuned model: the team's Adaption entry (training/step_tracker.py reads this)
ADAPTION_MODEL_ID=
# Pass 1's own fine-tune. Optional; Pass 1 stays on Claude. NEVER put the step tracker's id here.
PASS1_ADAPTION_MODEL_ID=

# Switches
PASS1_BACKEND=claude        # claude | adaption
PASS1_VISION_MODEL=claude-sonnet-5-5   # model for spoken turns that carry camera pictures; empty = Haiku for everything
FAL_ENABLED=0               # 0 = no generated media (rehearsal mode)
USE_MOCKS=1                 # 1 = every stage returns fixture data
STORE_BACKEND=sqlite        # databricks | sqlite
MOCK_LATENCY_MS=0           # simulated latency for mock stages

# App -> backend (tunnel URL)
EXPO_PUBLIC_API_URL=

# --- Training / knowledge pipeline (training/, databricks/, backend/parts_agent.py) ---
LINKUP_API_KEY=              # live parts / manual / recall research (backend/parts_agent.py)
TAVILY_API_KEY=              # web repair guides -> knowledge base (training/web_scrape.py)
DATABRICKS_TRAINING_SCHEMA=training   # knowledge data lives in spanner.training
MLFLOW_EXPERIMENT=/Shared/spanner-training
PARTS_OFFLINE=0              # 1 = only cached parts cards (stage mode when Wi-Fi is bad)
PARTS_COUNTRY=United Kingdom    # where the user shops: offers and new-unit prices are searched there
PARTS_CURRENCY=GBP              # other currencies are converted at the day's ECB rate for the repair-or-replace verdict
# The Adaption step tracker uses TOGETHER_API_KEY / ADAPTION_MODEL_ID / ADAPTION_BASE_URL above
